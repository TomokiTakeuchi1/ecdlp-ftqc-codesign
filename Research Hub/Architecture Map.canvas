      "width": 330,
      "height": 240,
      "color": "2"
    },
    {
      "id": "factory",
      "type": "text",
      "text": "# Factory / reservoir\nSupplies T or CCZ resource states.\n\nMonth 1: ideal supply; demand trace only.\nMonth 3: throughput, buffer, routing, spares, failure budget.",
      "x": 800,
